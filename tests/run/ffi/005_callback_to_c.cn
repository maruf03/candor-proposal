// SPEC: 04-ffi §2
// EXPECT: exit 0
extern "C" { fn qsort(base: u8*, n: usize, size: usize, cmp: fn(const u8*, const u8*) -> i32); }
fn cmp(a: const u8*, b: const u8*) -> i32 {
    let x = *(a as (const u32*));
    let y = *(b as (const u32*));
    if (x < y) { return -1; }
    if (x > y) { return 1; }
    return 0;
}

pub fn main() -> i32 {
mut a: u32[4] = [3, 1, 4, 2];
qsort(&a[0] as (u8*), 4, size_of(u32), cmp);
    if (!(a[0] == 1)) { return 1; }
    if (!(a[1] == 2)) { return 2; }
    if (!(a[2] == 3)) { return 3; }
    if (!(a[3] == 4)) { return 4; }
    return 0;
}
