// SPEC: 02-types §1
// EXPECT: exit 0
pub fn main() -> i32 {
    if (!(size_of(i8) == 1)) { return 1; }
    if (!(size_of(i16) == 2)) { return 2; }
    if (!(size_of(i32) == 4)) { return 3; }
    if (!(size_of(i64) == 8)) { return 4; }
    if (!(size_of(f32) == 4)) { return 5; }
    if (!(size_of(f64) == 8)) { return 6; }
    if (!(size_of(bool) == 1)) { return 7; }
    return 0;
}
