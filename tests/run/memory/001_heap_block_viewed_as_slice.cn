// SPEC: 03-memory §2
// EXPECT: exit 0
extern "C" { fn malloc(n: usize) -> u8*; fn free(p: u8*); }

pub fn main() -> i32 {
let raw = malloc(4 * size_of(u32));
if (raw == null) { return 1; }
let xs = slice(raw as (u32*), 4);
xs[0] = 10;
xs[3] = 40;
let ok = xs[0] + xs[3] == 50;
free(raw);
    if (!(ok)) { return 1; }
    return 0;
}
