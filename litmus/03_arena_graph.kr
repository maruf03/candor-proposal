// Litmus 3: graph / AST via typed arena indices (RFC 0001 §5 recommended pattern).
// Tests: distinct index types, cyclic structure without references, DFS with explicit stack.
import "std/mem";

pub type NodeIdx = distinct u32;

pub struct Node { first_edge: u32; edge_count: u32; visited: bool; }

pub linear struct Graph {
    nodes: mem.Buf[Node];
    edges: mem.Buf[NodeIdx];
}

impl Graph {
    pub fn node(self: &const Graph, n: NodeIdx) -> &const Node {
        return self.nodes.get(n as usize);
    }

    // Exclusive access to ONE element at a time; no aliasing possible.
    fn mark(self: &mut Graph, n: NodeIdx) { self.nodes.get_mut(n as usize).visited = true; }

    pub fn dfs(self: &mut Graph, root: NodeIdx, a: mem.Allocator) -> Result[u32, mem.AllocError] {
        mut stack = try mem.Buf[NodeIdx].init_zeroed(a, self.edges.len() + 1);
        defer stack.destroy();
        mut sp: usize = 0;
        mut seen: u32 = 0;
        stack.set(0, root);
        sp = 1;
        while (sp > 0) {
            sp -= 1;
            let n = *stack.get(sp);
            if (self.node(n).visited) { continue; }
            self.mark(n);
            seen += 1;
            // copy needed fields out first: no live borrow of `self` across the mutation below
            let first = self.node(n).first_edge;
            let cnt = self.node(n).edge_count;
            mut j: u32 = 0;
            while (j < cnt) {
                stack.set(sp, *self.edges.get((first + j) as usize));
                sp += 1;
                j += 1;
            }
        }
        return seen;
    }

    pub fn destroy(self: Graph) {
        let Graph{ nodes, edges } = self;
        nodes.destroy();
        edges.destroy();
    }
}
