// Litmus 3: graph via typed arena indices (the pattern the language recommends
// for cyclic structure). Exercises: distinct index types, built-in Buf indexing
// and element assignment, explicit-stack DFS, defer, errdefer.

pub type NodeIdx = distinct u32;

pub struct Node { first_edge: u32; edge_count: u32; visited: bool; }

pub linear struct Graph {
    nodes: Buf[Node];
    edges: Buf[NodeIdx];
}

impl Graph {
    pub fn init(n: usize, m: usize) -> Result[Graph, AllocError] {
        let blank = Node{ first_edge: 0, edge_count: 0, visited: false };
        let nodes = try Buf[Node].filled(n, blank);
        errdefer nodes.destroy();
        let edges = try Buf[NodeIdx].filled(m, 0 as NodeIdx);
        return Graph{ nodes: nodes, edges: edges };
    }

    pub fn link(self: &mut Graph, n: NodeIdx, first: u32, count: u32) {
        self.nodes[n as usize].first_edge = first;
        self.nodes[n as usize].edge_count = count;
    }

    pub fn set_edge(self: &mut Graph, slot: usize, to: NodeIdx) { self.edges[slot] = to; }

    // Number of nodes reachable from `root`. The stack never holds more than
    // edges + 1 entries: every edge is pushed at most once.
    pub fn dfs(self: &mut Graph, root: NodeIdx) -> Result[u32, AllocError] {
        mut stack = try Buf[NodeIdx].filled(self.edges.len() + 1, root);
        defer stack.destroy();
        mut sp: usize = 1;
        mut seen: u32 = 0;
        while (sp > 0) {
            sp -= 1;
            let n = stack[sp] as usize;
            if (self.nodes[n].visited) { continue; }
            self.nodes[n].visited = true;
            seen += 1;
            let first = self.nodes[n].first_edge;
            let count = self.nodes[n].edge_count;
            mut j: u32 = 0;
            while (j < count) {
                stack[sp] = self.edges[(first + j) as usize];
                sp += 1;
                j += 1;
            }
        }
        return seen;
    }

    pub fn destroy(self: Graph) {
        let Graph{ nodes, edges } = self;
        nodes.destroy();
        edges.destroy();
    }
}
