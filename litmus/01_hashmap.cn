// Litmus 1: generic open-addressing hash map over raw heap memory. Exercises:
// generics without traits (hash and equality are function-pointer fields),
// slices built from malloc with `slice`, a struct that owns memory by convention,
// replacing a field through a pointer, and errors as plain return values.

extern "C" {
    fn malloc(n: usize) -> u8*;
    fn free(p: u8*);
}

pub struct Map[K, V] {
    keys: K[];
    vals: V[];
    used: bool[];
    count: usize;
    hash: fn(K) -> u64;
    eq: fn(K, K) -> bool;
}

fn alloc_slice[T](n: usize) -> T[] {
    let p = malloc(n * size_of(T));
    if (p == null) { trap(); }
    return slice(p as (T*), n);
}

impl[K, V] Map[K, V] {
    pub fn new(cap: usize, hash: fn(K) -> u64, eq: fn(K, K) -> bool) -> Map[K, V] {
        let used = alloc_slice[bool](cap);
        for (i in 0..cap) { used[i] = false; }
        return Map[K, V]{
            keys: alloc_slice[K](cap), vals: alloc_slice[V](cap), used: used,
            count: 0, hash: hash, eq: eq
        };
    }

    pub fn destroy(self: Map[K, V]*) {
        free(self.keys.ptr as (u8*));
        free(self.vals.ptr as (u8*));
        free(self.used.ptr as (u8*));
        self.count = 0;
    }

    fn find(self: Map[K, V]*, key: K) -> usize {
        let cap = self.keys.len;
        mut i = (self.hash(key) % (cap as u64)) as usize;
        while (self.used[i] && !self.eq(self.keys[i], key)) {
            i = (i + 1) % cap;
        }
        return i;
    }

    fn grow(self: Map[K, V]*) {
        mut bigger = Map[K, V].new(self.keys.len * 2, self.hash, self.eq);
        for (i in 0..self.keys.len) {
            if (self.used[i]) { bigger.put(self.keys[i], self.vals[i]); }
        }
        self.destroy();
        *self = bigger;
    }

    pub fn put(self: Map[K, V]*, key: K, val: V) {
        if ((self.count + 1) * 4 > self.keys.len * 3) { self.grow(); }
        let i = self.find(key);
        if (!self.used[i]) {
            self.used[i] = true;
            self.keys[i] = key;
            self.count += 1;
        }
        self.vals[i] = val;
    }

    pub fn get(self: Map[K, V]*, key: K, out: V*) -> bool {
        let i = self.find(key);
        if (!self.used[i]) { return false; }
        *out = self.vals[i];
        return true;
    }
}

fn hash_u32(k: u32) -> u64 { return wrapping_mul(k as u64, 0x9E3779B97F4A7C15); }
fn eq_u32(a: u32, b: u32) -> bool { return a == b; }

pub fn main() -> i32 {
    mut m = Map[u32, u32].new(8, hash_u32, eq_u32);
    defer m.destroy();
    for (i in 0..1000) { m.put(i as u32, (i * 2) as u32); }
    mut v: u32 = 0;
    if (!m.get(7, &v)) { return 1; }
    if (v != 14) { return 2; }
    return 0;
}
