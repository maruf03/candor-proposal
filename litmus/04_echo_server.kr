// Litmus 4: blocking TCP echo server. Exercises: extern "C" calls as plain calls
// (no wrapper, no marker), errors as C-style return codes, `defer` in a loop,
// slices passed to C as ptr + len, pointer arithmetic for partial writes.

extern "C" {
    fn socket(domain: i32, kind: i32, proto: i32) -> i32;
    fn bind(fd: i32, addr: const u8*, len: u32) -> i32;
    fn listen(fd: i32, backlog: i32) -> i32;
    fn accept(fd: i32, addr: u8*, len: u32*) -> i32;
    fn read(fd: i32, buf: u8*, n: usize) -> isize;
    fn send(fd: i32, buf: const u8*, n: usize, flags: i32) -> isize;
    fn close(fd: i32) -> i32;
}

pub enum NetError : i32 { Ok, Socket, Bind, Listen, Accept, Io }

// 0x4000 = MSG_NOSIGNAL on Linux: no SIGPIPE when the peer has gone
fn write_all(fd: i32, buf: const u8[]) -> bool {
    mut off: usize = 0;
    while (off < buf.len) {
        let n = send(fd, buf.ptr + off, buf.len - off, 0x4000);
        if (n <= 0) { return false; }
        off += n as usize;
    }
    return true;
}

fn echo(conn: i32) {
    mut buf: u8[4096] = [0; 4096];
    mut n = read(conn, &buf[0], buf.len);
    while (n > 0) {
        if (!write_all(conn, buf[0..n as usize])) { return; }
        n = read(conn, &buf[0], buf.len);
    }
}

pub fn serve(sockaddr: const u8[]) -> NetError {
    let srv = socket(2, 1, 0);
    if (srv < 0) { return NetError.Socket; }
    defer close(srv);
    if (bind(srv, sockaddr.ptr, sockaddr.len as u32) < 0) { return NetError.Bind; }
    if (listen(srv, 128) < 0) { return NetError.Listen; }
    while (true) {
        let conn = accept(srv, null, null);
        if (conn < 0) { return NetError.Accept; }
        defer close(conn);              // runs at the end of every iteration
        echo(conn);
    }
}
