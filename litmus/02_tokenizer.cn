// Litmus 2: tokenizer. Tokens hold slices of the source directly: slices are
// plain values, so a token can carry its own text. Nothing tracks that the source
// outlives the tokens; the caller keeps it alive, as in C.

pub enum Kind : u8 { Eof, Ident, Number, Plus, Star, LParen, RParen, Bad }

pub struct Token { kind: Kind; text: const u8[]; }

pub struct Lexer { src: const u8[]; pos: usize; }

fn is_alpha(c: u8) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}
fn is_digit(c: u8) -> bool { return c >= '0' && c <= '9'; }

impl Lexer {
    pub fn next(self: Lexer*) -> Token {
        while (self.pos < self.src.len && self.src[self.pos] == ' ') { self.pos += 1; }
        let start = self.pos;
        if (start >= self.src.len) {
            return Token{ kind: Kind.Eof, text: self.src[start..start] };
        }
        let c = self.src[start];
        self.pos += 1;
        mut kind = Kind.Bad;
        if (is_alpha(c)) {
            while (self.pos < self.src.len && (is_alpha(self.src[self.pos]) || is_digit(self.src[self.pos]))) {
                self.pos += 1;
            }
            kind = Kind.Ident;
        } else if (is_digit(c)) {
            while (self.pos < self.src.len && is_digit(self.src[self.pos])) { self.pos += 1; }
            kind = Kind.Number;
        } else {
            switch (c) {
                case '+': { kind = Kind.Plus; }
                case '*': { kind = Kind.Star; }
                case '(': { kind = Kind.LParen; }
                case ')': { kind = Kind.RParen; }
                else: { }
            }
        }
        return Token{ kind: kind, text: self.src[start..self.pos] };
    }
}

pub fn same(a: const u8[], b: const u8[]) -> bool {
    if (a.len != b.len) { return false; }
    for (i in 0..a.len) {
        if (a[i] != b[i]) { return false; }
    }
    return true;
}

pub fn count_tokens(src: const u8[]) -> usize {
    mut lx = Lexer{ src: src, pos: 0 };
    mut n: usize = 0;
    mut t = lx.next();
    while (t.kind != Kind.Eof) {
        n += 1;
        t = lx.next();
    }
    return n;
}

pub fn main() -> i32 {
    // `=` is not a token kind here: it lexes as Kind.Bad but is still counted.
    if (count_tokens("let x = (a + 12) * b") != 10) { return 1; }
    return 0;
}
