// Litmus 1: open-addressing hash map over the built-in Buf.
// Exercises: Copy-bounded generics, function-pointer "interfaces", a linear owner,
// errdefer, swap on a linear value (map growth), Result/try, wrapping arithmetic.

pub enum MapError { NotFound }

pub linear struct Map[K: Copy, V: Copy] {
    keys: Buf[K];
    vals: Buf[V];
    used: Buf[bool];
    count: usize;
    hash: fn(K) -> u64;
    eq: fn(K, K) -> bool;
}

impl[K: Copy, V: Copy] Map[K, V] {
    // `k0` and `v0` fill the unused slots (Kore has no implicit zero value).
    pub fn init(cap: usize, k0: K, v0: V, hash: fn(K) -> u64,
                eq: fn(K, K) -> bool) -> Result[Map[K, V], AllocError] {
        if (cap == 0) { trap(); }
        let keys = try Buf[K].filled(cap, k0);
        errdefer keys.destroy();
        let vals = try Buf[V].filled(cap, v0);
        errdefer vals.destroy();
        let used = try Buf[bool].filled(cap, false);
        return Map[K, V]{ keys: keys, vals: vals, used: used, count: 0, hash: hash, eq: eq };
    }

    // Slot holding `key`, or the empty slot where it belongs. Terminates because
    // `put` keeps the load factor below 3/4.
    fn find(self: &const Map[K, V], key: K) -> usize {
        let cap = self.keys.len();
        mut i = self.hash(key) as usize % cap;
        while (self.used[i]) {
            if (self.eq(self.keys[i], key)) { return i; }
            i = (i + 1) % cap;
        }
        return i;
    }

    pub fn get(self: &const Map[K, V], key: K) -> Result[V, MapError] {
        let i = self.find(key);
        if (!self.used[i]) { return MapError.NotFound; }
        return self.vals[i];
    }

    fn insert_raw(self: &mut Map[K, V], key: K, val: V) {
        let i = self.find(key);
        if (!self.used[i]) {
            self.used[i] = true;
            self.keys[i] = key;
            self.count += 1;
        }
        self.vals[i] = val;
    }

    pub fn put(self: &mut Map[K, V], key: K, val: V) -> Result[void, AllocError] {
        if (self.count * 4 >= self.keys.len() * 3) { try self.grow(); }
        self.insert_raw(key, val);
    }

    fn grow(self: &mut Map[K, V]) -> Result[void, AllocError] {
        mut bigger = try Map[K, V].init(self.keys.len() * 2, self.keys[0], self.vals[0],
                                        self.hash, self.eq);
        for (i in 0..self.keys.len()) {
            if (self.used[i]) { bigger.insert_raw(self.keys[i], self.vals[i]); }
        }
        swap(self, &mut bigger);        // `bigger` now owns the old tables
        bigger.destroy();
    }

    pub fn destroy(self: Map[K, V]) {
        let Map{ keys, vals, used, .. } = self;
        keys.destroy();
        vals.destroy();
        used.destroy();
    }
}

fn hash_u32(k: u32) -> u64 { return wrapping_mul(k as u64, 0x9E3779B97F4A7C15); }
fn eq_u32(a: u32, b: u32) -> bool { return a == b; }

pub fn demo() -> Result[u32, AllocError] {
    mut m = try Map[u32, u32].init(16, 0, 0, hash_u32, eq_u32);
    defer m.destroy();
    try m.put(7, 49);
    return unwrap_or(m.get(7), 0);
}
