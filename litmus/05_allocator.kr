// Litmus 5: allocator + owning buffer. Tests: raw pointers + unsafe confined to
// std, linear owners, Zig-style allocator interface (struct of fn pointers).
// Safe API supports only STATELESS allocators (see LITMUS.md finding L5-1).
extern "C" {
    fn malloc(size: usize) -> ?u8*;
    fn free(p: u8*);
    fn memset(p: u8*, c: i32, n: usize) -> u8*;
    fn mmap(addr: usize, len: usize, prot: i32, flags: i32, fd: i32, off: i64) -> usize;
    fn munmap(addr: usize, len: usize) -> i32;
}

pub enum AllocError : i32 { OutOfMemory = 1 }

pub struct Allocator {
    ctx: ?u8*;
    alloc_fn: fn(?u8*, usize, usize) -> ?u8*;
    free_fn: fn(?u8*, u8*, usize);
}

fn heap_alloc(ctx: ?u8*, size: usize, align: usize) -> ?u8* {
    if (align > 16) { return null; }                // malloc guarantees 16
    unsafe { return malloc(size); }
}
fn heap_free(ctx: ?u8*, p: u8*, size: usize) { unsafe { free(p); } }

pub fn heap() -> Allocator {
    return Allocator{ ctx: null, alloc_fn: heap_alloc, free_fn: heap_free };
}

// Page-backed region. Exposes NO pointers to safe code; users get typed indices
// (see 03_arena_graph) or the unsafe contract below.
pub linear struct Region { base: usize; cap: usize; }

impl Region {
    pub fn init(cap: usize) -> Result[Region, AllocError] {
        mut addr: usize = 0;
        unsafe { addr = mmap(0, cap, 3, 0x22, -1, 0); }     // RW, PRIVATE|ANONYMOUS
        if (addr == (-1 as usize)) { return AllocError.OutOfMemory; }   // MAP_FAILED, not NULL
        return Region{ base: addr, cap: cap };
    }
    pub fn destroy(self: Region) {
        let Region{ base, cap } = self;
        unsafe { munmap(base, cap); }
    }
}

// Owning buffer. Elements must be Copy+Zero so that freeing the block can never
// skip a linear destructor and zero-init is always a valid value (finding L1-1).
pub linear struct Buf[T: Copy + Zero] {
    ptr: u8*;
    count: usize;
    alloc: Allocator;
}

impl[T: Copy + Zero] Buf[T] {
    pub fn init_zeroed(a: Allocator, n: usize) -> Result[Buf[T], AllocError] {
        let sz = size_of(T);
        // `count` must never exceed the allocation: reject a size that would wrap.
        if (sz != 0 && n > (-1 as usize) / sz) { return AllocError.OutOfMemory; }
        mut bytes = n * sz;
        if (bytes == 0) { bytes = 1; }                      // malloc(0) may return NULL
        let raw = a.alloc_fn(a.ctx, bytes, align_of(T));
        if (raw == null) { return AllocError.OutOfMemory; }
        unsafe { memset(raw, 0, bytes); }                    // raw narrowed to u8*
        return Buf[T]{ ptr: raw, count: n, alloc: a };
    }
    pub fn len(self: &const Buf[T]) -> usize { return self.count; }
    // Result borrows from `self` (single borrowed param): elision, no annotations.
    pub fn get(self: &const Buf[T], i: usize) -> &const T {
        if (i >= self.count) { trap(); }
        unsafe { return &const *((self.ptr + i * size_of(T)) as (T*)); }
    }
    pub fn get_mut(self: &mut Buf[T], i: usize) -> &mut T {
        if (i >= self.count) { trap(); }
        unsafe { return &mut *((self.ptr + i * size_of(T)) as (T*)); }
    }
    pub fn set(self: &mut Buf[T], i: usize, v: T) { *self.get_mut(i) = v; }
    pub fn destroy(self: Buf[T]) {
        let Buf{ ptr, count, alloc } = self;
        alloc.free_fn(alloc.ctx, ptr, count * size_of(T));
    }
}
